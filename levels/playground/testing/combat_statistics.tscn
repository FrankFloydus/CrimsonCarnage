[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://levels/playground/testing/combat_statistics.gd" id="1_script"]

[node name="Statistics" type="VBoxContainer"]
offset_right = 900.0
offset_bottom = 500.0
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 10
script = ExtResource("1_script")

[node name="Toolbar" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Toolbar"]
layout_mode = 2
theme_type_variation = &"PanelHeading"
text = "Damage by ability"
mouse_filter = 1
tooltip_text = "Damage and ability-use measurements for this session, grouped by source and ability."
size_flags_horizontal = 3

[node name="SourceFilter" type="OptionButton" parent="Toolbar"]
custom_minimum_size = Vector2(155, 0)
layout_mode = 2
tooltip_text = "Show damage and delivery outcomes from one actor, or combine sources."

[node name="Reset" type="Button" parent="Toolbar"]
layout_mode = 2
text = "Reset"
tooltip_text = "Start a new measurement without clearing the combat log or active effects."

[node name="TableScroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
vertical_scroll_mode = 0

[node name="Table" type="Tree" parent="TableScroll"]
custom_minimum_size = Vector2(900, 120)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
hide_root = true
column_titles_visible = true

[node name="Summary" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"PanelMuted"
text = "No combat recorded."
mouse_filter = 1
tooltip_text = "Damage counts actual Health removed. DPS divides that damage by elapsed measurement time. Scroll the table to see all columns."
autowrap_mode = 2

[node name="Refresh" type="Timer" parent="."]
wait_time = 0.25
autostart = true
