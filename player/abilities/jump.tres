[sub_resource type="Resource" id="Delivery_none"]
script = ExtResource("3_delivery")
kind = 8

[sub_resource type="Resource" id="Action_jump"]
script = ExtResource("6_jump")

[sub_resource type="Resource" id="Phase_start"]
script = ExtResource("4_phase")
event_key = &"ability.cast_started"
actions = Array[ExtResource("5_action")]([SubResource("Action_jump")])
