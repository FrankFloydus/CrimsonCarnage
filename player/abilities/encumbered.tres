actions = Array[ExtResource("6_action")]([SubResource("Action_maintain")])

[sub_resource type="Resource" id="Action_finish"]
script = ExtResource("8_finish")

[sub_resource type="Resource" id="Phase_finish"]
script = ExtResource("5_phase")
event_key = &"Event.Carry.WithinCapacity"
synchronous_gameplay_event = true
actions = Array[ExtResource("6_action")]([SubResource("Action_finish")])

[sub_resource type="Resource" id="Execution_encumbered"]
script = ExtResource("2_execution")
cast_mode = 5
delivery = SubResource("Delivery_none")
phases = Array[ExtResource("5_phase")]([SubResource("Phase_start"), SubResource("Phase_finish")])

[resource]
script = ExtResource("1_ability")
ability_id = 4
display_name = "Encumbered"
icon = ExtResource("11_icon")
ability_tags = PackedStringArray("Ability.Status.Encumbered")
required_tags = PackedStringArray()
