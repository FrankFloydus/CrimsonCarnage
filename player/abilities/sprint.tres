[sub_resource type="Resource" id="Delivery_none"]
script = ExtResource("4_delivery")
kind = 8

[sub_resource type="Resource" id="Action_start"]
script = ExtResource("7_start")
upkeep_effect = ExtResource("3_upkeep")

[sub_resource type="Resource" id="Phase_start"]
script = ExtResource("5_phase")
event_key = &"ability.cast_started"
actions = Array[ExtResource("6_action")]([SubResource("Action_start")])
failure_policy = 2

[sub_resource type="Resource" id="Action_finish"]
script = ExtResource("8_finish")

[sub_resource type="Resource" id="Phase_release"]
script = ExtResource("5_phase")
event_key = &"ability.input_released"
actions = Array[ExtResource("6_action")]([SubResource("Action_finish")])

[sub_resource type="Resource" id="Action_cancel"]
script = ExtResource("8_finish")
cancel_cast = true

[sub_resource type="Resource" id="Phase_depleted"]
script = ExtResource("5_phase")
event_key = &"Event.Stamina.Depleted"
synchronous_gameplay_event = true
actions = Array[ExtResource("6_action")]([SubResource("Action_cancel")])

[sub_resource type="Resource" id="Execution_sprint"]
script = ExtResource("2_execution")
cast_mode = 5
delivery = SubResource("Delivery_none")
phases = Array[ExtResource("5_phase")]([SubResource("Phase_start"), SubResource("Phase_release"), SubResource("Phase_depleted")])

[sub_resource type="Resource" id="Policy_sprint"]
script = ExtResource("13_interrupt_policy")
activation_blockers = PackedStringArray("State.Encumbered", "State.Control.Rooted", "State.Control.Stunned")
activation_exceptions = PackedStringArray()
cancel_on_tags = PackedStringArray("State.Encumbered", "State.Control.Rooted", "State.Control.Stunned")
interruptible_by_action = false
occupied_channels = PackedStringArray()
compatible_channels = PackedStringArray()

[resource]
script = ExtResource("1_ability")
ability_id = 1
display_name = "Sprint"
icon = ExtResource("14_icon")
ability_tags = PackedStringArray("Ability.Movement.Sprint")
required_tags = PackedStringArray()
activation_tags = PackedStringArray("State.Movement.Sprinting", "State.Stamina.RecoveryBlocked")
cancel_ability_tags = PackedStringArray()
block_ability_tags = PackedStringArray()
interruption_policy = SubResource("Policy_sprint")
execution = SubResource("Execution_sprint")
