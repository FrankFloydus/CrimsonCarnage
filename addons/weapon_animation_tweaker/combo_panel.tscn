[node name="ExitSettings" type="HBoxContainer" parent="Inset/Layout/TransitionInspector/Outgoing"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 5

[node name="ExitMarker" type="OptionButton" parent="Inset/Layout/TransitionInspector/Outgoing/ExitSettings"]
unique_name_in_owner = true
layout_mode = 2
